# ─── Environment & Secrets ──────────────────────────────────────────────────
# NEVER commit these — they contain API keys and tokens
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
!.env.example        # Allow the safe example template

# ─── Build Output ─────────────────────────────────────────────────────────────
# Generated by Vite/tsc — never commit build artifacts
dist/
dist-ssr/
build/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Generated / Auto-synced data ─────────────────────────────────────────────
# These are generated at build-time by scripts — not source files
public/gallery/manifest.json
public/data/pinned-repos.json

# ─── OS & Editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Misc ─────────────────────────────────────────────────────────────────────
.cache/
.parcel-cache/
fetch_github.py
udemy.html
test_*.js
test_*.cjs



# ─── Large Binary Wallpapers (too large for HTTPS push) ──────────────────────
# HEIC files are macOS-specific and 23-24MB each — JPG versions are included
public/wallpapers/*.heic
# 24MB PNG — JPG version (macOS_Tahoe_LightDefault.jpg) is included
public/wallpapers/26-Tahoe-Beach-Day.png

# Large animated GIF (too large for reliable HTTPS push)
public/img/ui/siri-motion.gif
