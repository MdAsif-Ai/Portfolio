# Environment variables — copy this file to .env and fill in your values
# DO NOT commit the real .env file — it is gitignored

# ─── GitHub Token ─────────────────────────────────────────────────────────────
# Used by scripts/fetch-pinned-repos.mjs at build time to fetch your pinned repos.
# Get a Classic Token at: https://github.com/settings/tokens
# Required scope: read:user
GITHUB_TOKEN=ghp_yourGitHubTokenHere

# ─── Tavily API Key ───────────────────────────────────────────────────────────
# Used for AI-powered search features (if any)
# Get one at: https://app.tavily.com
TAVILY_API_KEY=tvly-yourTavilyKeyHere
