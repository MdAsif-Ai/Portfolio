{
  "name": "macos-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "predev": "node scripts/generate-gallery-manifest.mjs && node scripts/fetch-pinned-repos.mjs && node scripts/generate-sitemap.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-gallery-manifest.mjs && node scripts/fetch-pinned-repos.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/gsap": "^1.20.2",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
